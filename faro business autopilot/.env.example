NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=
N8N_API_KEYS=

# Faro's "New Lead Follow-Up" workflow — triggered from /api/leads after AI scoring
N8N_LEAD_WEBHOOK_URL=
N8N_LEAD_WEBHOOK_SECRET=

# Server-only — AI providers for the ai_providers/ai_models router
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Redis — backs BullMQ for background_jobs/scheduled_jobs
REDIS_URL=

# Backblaze B2 (S3-compatible) — backs the files/file_versions module
# Use a bucket-scoped Application Key here, never the Master Application Key.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=
B2_REGION=
B2_PUBLIC_URL=

# Stripe — backs orders/invoices/payments/refunds/subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Twenty CRM — self-hosted locally for now, see deploy/twenty-crm/
CRM_API_URL=
CRM_API_KEY=

# Puppeteer — point at a system-installed Chrome instead of downloading one
PUPPETEER_SKIP_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Internal dashboard (/dashboard) — comma-separated emails allowed to sign in
ADMIN_EMAILS=

# Set to "true" on memory-constrained deployments to skip Puppeteer/Chrome
# PDF rendering in /api/reports — report content still generates and saves,
# just without a PDF file.
DISABLE_PDF_RENDERING=false
